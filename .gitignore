# Unity generated
/TestResults*.xml
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# 안드로이드 빌드가 쓰는 임시 폴더(CMake·ninja 캐시).
# 빌드할 때마다 유니티가 새로 만들므로 저장소에 둘 이유가 없다.
# 들어 있으면 빌드만 해도 파일 수십 개가 변경으로 잡힌다.
/.utmp/

# Asset meta data for ignored folders
!/[Aa]ssets/**/*.meta

# Visual Studio / Rider / VS Code
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D build artifacts
*.apk
*.aab
*.unitypackage
*.app
sysinfo.txt
crashlytics-build.properties

# Gradle / Android
.gradle/
local.properties

# Brainstorming companion (local only)
.superpowers/

# OS
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# 빌드·테스트·에셋 생성 로그 (이름이 매번 달라져 하나씩 적을 수 없다)
/*.log
/TestResults*.xml

# 작업 중 생긴 임시 산출물 — 디자인 검수 스크린샷, 이미지 생성 스크래치
/tmp/
/design-audit/
__pycache__/

# 서명키. 저장소에 절대 들어가면 안 된다
*.keystore
*.jks
*.p12
keystore.properties

# 받은 스킨 꾸러미의 zip은 옆 폴더와 같은 내용이라 넣지 않는다
delivery/**/*.zip
